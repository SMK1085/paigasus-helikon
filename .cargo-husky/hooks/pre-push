#!/usr/bin/env sh
# .cargo-husky-managed pre-push hook for paigasus-helikon.
# Runs the three fastest CI gates before push so simple slips don't burn a
# CI round-trip:
#   - cargo fmt --all -- --check
#   - cargo clippy --workspace --all-features --all-targets -- -D warnings
#   - convco check <merge-base>..HEAD  (Conventional Commits scope allowlist)
#
# Deliberately omits:
#   - cargo test --workspace --all-features  (too slow per-push; CI catches)
#   - cargo doc / doc-coverage                (slow; CI catches)
#
# Bypass for WIP branches you want CI to evaluate verbatim:
#   git push --no-verify

set -e

remote="$1"
url="$2"

# Read each ref being pushed; bail on delete-only pushes.
any_real_push=0
while read -r local_ref local_sha remote_ref remote_sha; do
  if [ "$local_sha" = "0000000000000000000000000000000000000000" ]; then
    continue  # delete; skip
  fi
  any_real_push=1

  # Pick a baseline for convco. Prefer the remote's existing ref; otherwise
  # try $remote/main (correct for fork-based contributors pushing to their
  # own remote), then fall back to origin/main.
  if [ "$remote_sha" != "0000000000000000000000000000000000000000" ]; then
    candidate="$remote_sha"
  else
    candidate=$(git rev-parse --verify --quiet "$remote/main" \
                || git rev-parse --verify --quiet origin/main \
                || true)
  fi

  # Reduce the candidate to its merge-base with the ref being pushed.
  #
  # This is load-bearing, not tidiness: `convco check A..B` only walks the
  # commits git would list when A is an ANCESTOR of B. Given a diverged A it
  # silently falls back to the entire history instead — on this repo that is
  # 220 commits reaching back to "Initial commit", three of which predate the
  # scope allowlist and can never be made to pass. The candidate above is
  # diverged in the ordinary case: any branch whose first push happens after
  # `main` has moved ahead of its branch point. Feeding the tip directly
  # therefore rejects perfectly good branches, which is what this hook did
  # until SMA-547.
  #
  # A merge-base is an ancestor by construction, so the range is exactly the
  # branch's own commits. Applied to `remote_sha` too, where it is a no-op
  # unless a force-push left the old remote tip off the new history.
  base=""
  if [ -n "$candidate" ]; then
    base=$(git merge-base "$candidate" "$local_sha" 2>/dev/null || true)
  fi

  if [ -n "$base" ] && command -v convco >/dev/null 2>&1; then
    if ! convco check "$base..$local_sha" >/dev/null 2>&1; then
      echo "pre-push: convco rejected commits in $base..$local_sha" >&2
      echo "  run: convco check $base..$local_sha" >&2
      exit 1
    fi
  fi
done

if [ "$any_real_push" -eq 0 ]; then
  exit 0
fi

# Format + clippy gates. These do not need per-ref iteration.
if ! cargo fmt --all -- --check; then
  echo "pre-push: rustfmt would reformat files. Run: cargo fmt --all" >&2
  exit 1
fi

if ! cargo clippy --workspace --all-features --all-targets -- -D warnings; then
  echo "pre-push: clippy found warnings. Fix them or run: git push --no-verify" >&2
  exit 1
fi
